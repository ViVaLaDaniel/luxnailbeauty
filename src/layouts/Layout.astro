---
import 'bootstrap/dist/css/bootstrap.min.css';

interface Props {
  title?: string;
  description?: string;
}

const { 
  title = "LuxNail & Beauty — Персональное AI-предложение для Юлии",
  description = "Эксклюзивное предложение по развитию бренда и автоматизации контента для Юлии, владельца LuxNail & Beauty в Барселоне."
} = Astro.props;
---

<!DOCTYPE html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    
    <!-- Google Fonts: Cormorant Garamond for Serifs, Outfit for Body text -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    
    <!-- Tabler Icons CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/tabler-icons.min.css">
  </head>
  <body>
    <div class="app-container">
      <main class="app-content">
        <slot />
      </main>
    </div>

    <!-- Bootstrap Bundle JS -->
    <script>
      import 'bootstrap/dist/js/bootstrap.bundle.min.js';
    </script>
  </body>
</html>

<style is:global>
  /* --- Luxury Theme Variables --- */
  :root {
    --ln-bg-primary: #12080F;
    --ln-bg-secondary: #1C0D17;
    --ln-bg-tertiary: #2D1624;
    --ln-gold-primary: #D4AF37;
    --ln-gold-secondary: #C5A880;
    --ln-rose-primary: #E8A0B0;
    --ln-rose-dark: #C9556F;
    --ln-rose-light: #F7E8EC;
    --ln-text-primary: #F7E8EC;
    --ln-text-secondary: rgba(247, 232, 236, 0.7);
    --ln-border-color: rgba(212, 175, 106, 0.15);
    --ln-border-glow: rgba(232, 160, 176, 0.25);
    --ln-font-heading: 'Cormorant Garamond', Georgia, serif;
    --ln-font-body: 'Outfit', system-ui, -apple-system, sans-serif;
  }

  /* --- Global Reset & Base Styles --- */
  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  body {
    background-color: #0b0409;
    color: var(--ln-text-primary);
    font-family: var(--ln-font-body);
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    min-height: 100vh;
    display: flex;
    justify-content: center;
    align-items: flex-start;
  }

  /* --- App Shell (Mobile First Preview Frame) --- */
  .app-container {
    width: 100%;
    max-width: 500px;
    min-height: 100vh;
    background-color: var(--ln-bg-primary);
    box-shadow: 0 0 50px rgba(0, 0, 0, 0.8), 0 0 100px rgba(201, 85, 111, 0.05);
    position: relative;
    overflow-x: hidden;
    border-left: 1px solid rgba(212, 175, 106, 0.08);
    border-right: 1px solid rgba(212, 175, 106, 0.08);
  }

  .app-content {
    padding: 1rem 1rem 3rem 1rem;
  }

  /* --- Animations --- */
  @keyframes fadeUp {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  @keyframes shimmer {
    0% { background-position: -200% center; }
    100% { background-position: 200% center; }
  }

  @keyframes pulse {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.03); }
  }

  @keyframes float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-6px); }
  }

  @keyframes glow {
    0%, 100% { opacity: 0.35; }
    50% { opacity: 0.7; }
  }

  /* --- Scroll Trigger Animation Utility --- */
  .au {
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1), transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .au.active {
    opacity: 1;
    transform: translateY(0);
  }

  /* --- Glassmorphic Section Cards --- */
  .section-card {
    background: rgba(28, 13, 23, 0.65);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid var(--ln-border-color);
    border-radius: 20px;
    padding: 1.5rem 1.25rem;
    margin-bottom: 16px;
    box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.37);
  }

  .sc-label {
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: var(--ln-gold-secondary);
    margin-bottom: 1.25rem;
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .sc-label::after {
    content: '';
    flex: 1;
    height: 1px;
    background: linear-gradient(90deg, var(--ln-border-color), transparent);
  }

  /* Custom Scrollbar for Luxury Vibe */
  ::-webkit-scrollbar {
    width: 6px;
  }
  ::-webkit-scrollbar-track {
    background: var(--ln-bg-primary);
  }
  ::-webkit-scrollbar-thumb {
    background: var(--ln-bg-tertiary);
    border-radius: 3px;
  }
  ::-webkit-scrollbar-thumb:hover {
    background: var(--ln-gold-secondary);
  }
</style>
