---
---
<div class="hero au">
  <!-- Glowing luxury blurred background elements -->
  <div class="hero-orb-1"></div>
  <div class="hero-orb-2"></div>
  
  <!-- Subtle salon interior background overlay -->
  <div class="hero-bg-image"></div>
  <div class="hero-overlay"></div>

  <div class="hero-content">
    <div class="hero-logo-wrap">
      <div class="hero-logo-icon">
        <span>LN</span>
      </div>
      <div class="hero-logo-text">
        <h1 class="hero-logo-name">LuxNail & Beauty</h1>
        <div class="hero-logo-sub">Barcelona · Since 2020</div>
      </div>
    </div>
    
    <div class="hero-line"></div>
    <div class="hero-badge">
      <i class="ti ti-sparkles gold-sparkle" aria-hidden="true"></i>
      AI Content Proposal 2026
    </div>
    
    <h2 class="hero-h1">Система контента,<br>которая работает<br><span>пока вы работаете</span></h2>
    
    <p class="hero-desc">
      Мы детально проанализировали ваш бизнес. Ваш премиальный бренд заслуживает масштабного охвата и безупречного цифрового присутствия. Мы знаем, как это реализовать.
    </p>
    
    <div class="hero-divider"></div>
  </div>
</div>

<style>
  .hero {
    position: relative;
    background: #12080F;
    border-radius: 24px;
    padding: 3rem 1.5rem 2.5rem;
    text-align: center;
    margin-bottom: 16px;
    overflow: hidden;
    border: 1px solid rgba(212, 175, 106, 0.2);
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.5);
  }

  .hero-bg-image {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-image: url('/images/luxury_salon_interior.png');
    background-size: cover;
    background-position: center;
    opacity: 0.18;
    z-index: 1;
    filter: saturate(0.8) contrast(1.1);
  }

  .hero-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(180deg, rgba(18, 8, 15, 0.4) 0%, #12080F 100%);
    z-index: 2;
  }

  .hero-orb-1, .hero-orb-2 {
    position: absolute;
    border-radius: 50%;
    filter: blur(50px);
    animation: glow 6s ease-in-out infinite;
    z-index: 2;
  }

  .hero-orb-1 {
    width: 200px;
    height: 200px;
    background: rgba(201, 85, 111, 0.18);
    top: -50px;
    left: -50px;
    animation-delay: 0s;
  }

  .hero-orb-2 {
    width: 180px;
    height: 180px;
    background: rgba(184, 150, 62, 0.12);
    bottom: -40px;
    right: -40px;
    animation-delay: 3s;
  }

  .hero-content {
    position: relative;
    z-index: 3;
  }

  .hero-logo-wrap {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    margin-bottom: 1.5rem;
  }

  .hero-logo-icon {
    width: 50px;
    height: 50px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--ln-rose-dark) 0%, #a83b54 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(212, 175, 106, 0.35);
    box-shadow: 0 4px 15px rgba(201, 85, 111, 0.3);
    animation: float 5s ease-in-out infinite;
  }

  .hero-logo-icon span {
    font-family: var(--ln-font-heading);
    font-size: 19px;
    font-weight: 700;
    color: var(--ln-rose-light);
    letter-spacing: 0.5px;
    text-shadow: 0 2px 4px rgba(0, 0, 0, 0.3);
  }

  .hero-logo-text {
    text-align: left;
  }

  .hero-logo-name {
    font-family: var(--ln-font-heading);
    font-size: 22px;
    font-weight: 600;
    color: var(--ln-text-primary);
    margin: 0;
    line-height: 1.1;
    letter-spacing: 0.5px;
  }

  .hero-logo-sub {
    font-size: 9.5px;
    font-weight: 500;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--ln-gold-primary);
    margin-top: 2px;
  }

  .hero-line {
    width: 60px;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--ln-gold-primary), transparent);
    margin: 0 auto 1.25rem;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 9.5px;
    font-weight: 600;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: var(--ln-gold-primary);
    border: 1px solid rgba(184, 150, 62, 0.45);
    background: rgba(184, 150, 62, 0.06);
    padding: 5px 14px;
    border-radius: 20px;
    margin-bottom: 1.5rem;
    backdrop-filter: blur(4px);
  }

  .gold-sparkle {
    color: var(--ln-gold-primary);
    animation: pulse 2s ease infinite;
  }

  .hero-h1 {
    font-family: var(--ln-font-heading);
    font-size: 28px;
    font-weight: 500;
    color: var(--ln-text-primary);
    line-height: 1.25;
    margin-bottom: 1rem;
  }

  .hero-h1 span {
    font-style: italic;
    color: var(--ln-rose-primary);
    background: linear-gradient(120deg, #E8A0B0 0%, #ffc4d2 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .hero-desc {
    font-size: 13px;
    color: var(--ln-text-secondary);
    line-height: 1.7;
    max-width: 90%;
    margin: 0 auto;
  }

  .hero-divider {
    width: 80px;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(184, 150, 62, 0.4), transparent);
    margin: 1.25rem auto 0;
  }
</style>
