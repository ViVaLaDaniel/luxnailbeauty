<style>
  .msg-block {
    background: rgba(28, 13, 23, 0.65);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid var(--ln-border-color);
    border-radius: 24px;
    padding: 1.5rem 1.25rem;
    margin-bottom: 16px;
    box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.37);
    transition: background-color 0.5s ease, border-color 0.5s ease, box-shadow 0.5s ease;
  }

  /* Target element highlight state after scrolling from CTA */
  .msg-block.highlight-flash {
    background: rgba(201, 85, 111, 0.15);
    border-color: rgba(201, 85, 111, 0.5);
    box-shadow: 0 0 30px rgba(201, 85, 111, 0.3);
  }

  .msg-head {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 1.25rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .msg-av {
    width: 42px;
    height: 42px;
    border-radius: 50%;
    background: linear-gradient(135deg, #25D366 0%, #128C7E 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    font-size: 22px;
    flex-shrink: 0;
    box-shadow: 0 4px 10px rgba(37, 211, 102, 0.25);
  }

  .msg-ht {
    font-size: 14.5px;
    font-weight: 600;
    color: var(--ln-text-primary);
    margin: 0;
  }

  .msg-hs {
    font-size: 11px;
    color: var(--ln-text-secondary);
  }

  .msg-body {
    font-size: 12.5px;
    color: var(--ln-text-primary);
    line-height: 1.8;
    white-space: pre-line;
    background: rgba(18, 8, 15, 0.3);
    padding: 1.125rem;
    border-radius: 16px;
    border: 1px solid rgba(255, 255, 255, 0.04);
  }

  .copy-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    margin-top: 1.25rem;
    padding: 12px 16px;
    border: 1px solid rgba(212, 175, 106, 0.3);
    border-radius: 14px;
    background: linear-gradient(135deg, #1C0D17 0%, #12080F 100%);
    color: var(--ln-gold-primary);
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
    width: 100%;
    transition: transform 0.2s ease, background 0.3s ease, border-color 0.3s ease;
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.15);
  }

  .copy-btn:hover {
    background: rgba(45, 22, 36, 0.3);
    border-color: var(--ln-gold-primary);
  }

  .copy-btn:active {
    transform: scale(0.98);
  }

  /* --- Brand Resources Style --- */
  .brand-resources-card {
    background: rgba(18, 8, 15, 0.5);
    border: 1px solid var(--ln-border-color);
    border-radius: 20px;
    padding: 1.25rem;
    margin-bottom: 16px;
  }

  .resources-head {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: var(--ln-gold-primary);
    margin-bottom: 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid rgba(212, 175, 106, 0.08);
  }

  .resources-head i {
    font-size: 13px;
  }

  .resources-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 10px;
  }

  .resource-link {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 12px;
    background: rgba(28, 13, 23, 0.4);
    border: 1px solid rgba(255, 255, 255, 0.04);
    border-radius: 12px;
    text-decoration: none;
    color: var(--ln-text-primary);
    transition: border-color 0.3s ease, background 0.3s ease;
  }

  .resource-link:hover {
    border-color: var(--ln-border-glow);
    background: rgba(45, 22, 36, 0.2);
  }

  .resource-icon {
    width: 28px;
    height: 28px;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 14px;
    color: white;
    flex-shrink: 0;
  }

  .resource-icon.instagram {
    background: radial-gradient(circle at 30% 107%, #fdf497 0%, #fdf497 5%, #fd5949 45%,#d6249f 60%,#285AEB 90%);
  }

  .resource-icon.instagram-academy {
    background: linear-gradient(135deg, #FF512F 0%, #DD2476 100%);
  }

  .resource-icon.google-map {
    background: linear-gradient(135deg, #4285F4 0%, #34A853 100%);
  }

  .resource-details {
    display: flex;
    flex-direction: column;
    flex-1: 1;
    overflow: hidden;
  }

  .resource-name {
    font-size: 10.5px;
    font-weight: 500;
    color: var(--ln-text-primary);
  }

  .resource-handle {
    font-size: 9px;
    color: var(--ln-text-secondary);
    white-space: nowrap;
    text-overflow: ellipsis;
    overflow: hidden;
  }

  .resource-arrow {
    margin-left: auto;
    font-size: 11px;
    color: var(--ln-text-secondary);
    transition: transform 0.2s ease, color 0.2s ease;
  }

  .resource-link:hover .resource-arrow {
    transform: translate(2px, -2px);
    color: var(--ln-rose-primary);
  }

  @media (max-width: 375px) {
    .resources-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  function setupClipboardCopy() {
    const btn = document.getElementById('copyBtn');
    const txtElement = document.getElementById('msgTxt');
    const iconElement = document.getElementById('copyIcon');
    const textSpan = document.getElementById('copyBtnText');

    if (btn && txtElement && iconElement && textSpan) {
      btn.addEventListener('click', () => {
        const textToCopy = txtElement.innerText;
        navigator.clipboard.writeText(textToCopy).then(() => {
          // Success State
          iconElement.className = 'ti ti-check';
          textSpan.innerText = 'Сообщение скопировано!';
          btn.style.borderColor = 'rgba(37, 211, 102, 0.6)';
          
          setTimeout(() => {
            // Restore Original State
            iconElement.className = 'ti ti-copy';
            textSpan.innerText = 'Скопировать сообщение';
            btn.style.borderColor = 'rgba(212, 175, 106, 0.3)';
          }, 2500);
        }).catch(err => {
          console.error('Copy to clipboard failed: ', err);
        });
      });
    }
  }

  // Setup on mount
  setupClipboardCopy();

  // Astro page transitions support
  document.addEventListener('astro:after-swap', setupClipboardCopy);
</script>
